{
  "name": "factfind-pro",
  "version": "0.1.0",
  "private": true,
  "description": "FactFind Pro — SaaS fact-find platform for UK Mortgage & Protection Brokers (Wealthy Advisors Club)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:seed": "supabase db reset --no-seed=false",
    "import:typeform": "node scripts/import-typeform.mjs",
    "prepare:advisers": "node scripts/prepare-adviser-import.mjs",
    "stage:advisers": "node scripts/stage-adviser-batch.mjs",
    "test:adviser-import": "node --test tests/scripts/adviser-import.test.mjs tests/scripts/adviser-batch.test.mjs tests/scripts/provisioning-fetch.test.mjs",
    "test:transfer": "node --test tests/scripts/transfer-pack.test.mjs",
    "pack:transfer": "node scripts/create-transfer-pack.mjs",
    "provision:advisers": "node --env-file=.env.local scripts/provision-adviser-batch.mjs",
    "verify:typeform": "node scripts/verify-typeform-import.mjs",
    "verify:typeforms": "node scripts/verify-typeforms.mjs",
    "preview:client": "node tests/start-preview.mjs",
    "test:e2e": "npm run build:preview && playwright test",
    "build:preview": "node tests/start-preview.mjs --build",
    "test:unit": "playwright test --config playwright.unit.config.ts",
    "test:email-flow": "playwright test --config playwright.email.config.ts",
    "test:responsive": "playwright test --config playwright.responsive.config.ts",
    "test:webkit": "playwright test --config playwright.webkit.config.ts",
    "email:test": "tsx scripts/test-email.ts",
    "check:pdf-assets": "node scripts/check-pdf-assets.mjs"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.47.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "^0.469.0",
    "next": "15.5.25",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "sharp": "^0.35.4",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.25",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.17",
    "tsx": "4.23.13",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
