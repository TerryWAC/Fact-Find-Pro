# ---------------------------------------------------------------------------
# FactFind Pro — environment variables
# Copy to .env.local for development, and set the same keys in Vercel.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. Server-only — never prefix with NEXT_PUBLIC_.
# Needed for: admin notification recipients, email delivery logging and the
# adviser "new submission" email. The app degrades gracefully without it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Application -----------------------------------------------------------
# Absolute base URL. Used to build client FactFind links and email links.
# Vercel sets VERCEL_URL automatically, but set this for a custom domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (optional) ------------------------------------------------------
# Without RESEND_API_KEY, emails are written to the server log and email_log
# table so every flow stays testable locally.
RESEND_API_KEY=
EMAIL_FROM="FactFind Pro <noreply@yourdomain.co.uk>"
EMAIL_REPLY_TO=support@wealthyadvisorsclub.co.uk

# Comma-separated admin inbox for new-registration alerts.
# Falls back to every approved admin in the profiles table when unset.
ADMIN_NOTIFICATION_EMAIL=admin@wealthyadvisorsclub.co.uk

# Shown to users in the UI as the support contact.
NEXT_PUBLIC_SUPPORT_EMAIL=support@wealthyadvisorsclub.co.uk
